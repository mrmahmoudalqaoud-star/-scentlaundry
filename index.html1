<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>DOLMA | الدولمة</title>

<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">

<style>
*{
    box-sizing:border-box;
}

body{
    margin:0;
    font-family:'Cairo',sans-serif;
    background:
    radial-gradient(circle at top,#3b2508 0%,#111 35%,#050505 100%);
    color:white;
    min-height:100vh;
    padding:25px 15px;
}

.container{
    width:100%;
    max-width:430px;
    margin:auto;
    text-align:center;
}

.logo{
    width:105px;
    height:105px;
    margin:10px auto 15px;
    border-radius:50%;
    background:#111;
    border:2px solid #d99a32;
    display:flex;
    align-items:center;
    justify-content:center;
    box-shadow:0 0 30px rgba(218,154,50,.3);
}

.logo span{
    font-size:25px;
    font-weight:800;
    color:#d99a32;
}

h1{
    margin:5px 0 0;
    font-size:38px;
    letter-spacing:3px;
    color:#d99a32;
}

.subtitle{
    color:#ddd;
    font-size:15px;
    margin-bottom:25px;
}

.buttons a{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:10px;
    text-decoration:none;
    color:white;
    background:rgba(255,255,255,.07);
    border:1px solid rgba(217,154,50,.5);
    border-radius:17px;
    padding:15px;
    margin:12px 0;
    font-size:17px;
    font-weight:700;
    transition:.25s;
    backdrop-filter:blur(10px);
}

.buttons a:hover{
    transform:scale(1.03);
    background:#d99a32;
    color:#111;
}

.menu{
    margin-top:25px;
    background:rgba(255,255,255,.06);
    border:1px solid rgba(217,154,50,.35);
    border-radius:22px;
    padding:20px 17px;
    text-align:right;
}

.menu-title{
    text-align:center;
    color:#d99a32;
    font-size:23px;
    font-weight:800;
    margin-bottom:18px;
}

.section{
    color:#e5a64a;
    font-size:18px;
    font-weight:800;
    margin:18px 0 8px;
    border-bottom:1px solid #694b1c;
    padding-bottom:5px;
}

.item{
    display:flex;
    justify-content:space-between;
    gap:10px;
    padding:7px 0;
    color:#eee;
    font-size:15px;
}

.price{
    color:#d99a32;
    font-weight:800;
    white-space:nowrap;
}

.note{
    text-align:center;
    color:#aaa;
    font-size:13px;
    margin-top:15px;
}

.footer{
    margin:25px 0 10px;
    color:#777;
    font-size:13px;
}
</style>
</head>

<body>

<div class="container">

    <div class="logo">
        <span>DOLMA</span>
    </div>

    <h1>DOLMA</h1>

    <div class="subtitle">
        الدولمة • اليالنجي • الأكلات البيتية
    </div>

    <div class="buttons">

        <a href="https://wa.me/message/R5JLJQPGYUKOD1">
            💬 اطلب عبر واتساب
        </a>

        <a href="https://www.instagram.com/dolmakitchen?igsi=MTNlZ3UzcThiZDlrNQ==">
            📸 Instagram
        </a>

        <a href="https://snapchat.com/t/j0Q0P1mh">
            👻 Snapchat
        </a>

        <a href="https://www.facebook.com/share/14qZZEadieB/?mibextid=wwXIfr">
