        </div>

        <div class="item">
            <span>تبولة</span>
            <span class="price">2 د.أ</span>
        </div>

        <div class="item">
            <span>فتة دولمة</span>
            <span class="price">2 د.أ</span>
        </div>

        <div class="item">
            <span>يلنجي</span>
            <span class="price">2 د.أ</span>
        </div>

        <div class="section">أطباق جانبية</div>

        <div class="item">
            <span>تبولة</span>
            <span class="price">5 د.أ</span>
        </div>

        <div class="item">
            <span>10 رول مسخن</span>
            <span class="price">5 د.أ</span>
        </div>

        <div class="item">
            <span>10 حبة برغل</span>
            <span class="price">5 د.أ</span>
        </div>

        <div class="item">
            <span>10 حبة رز</span>
            <span class="price">4 د.أ</span>
        </div>

        <div class="item">
            <span>10 حبة جريش</span>
            <span class="price">4 د.أ</span>
        </div>

        <div class="item">
            <span>فتة دولمة</span>
            <span class="price">4 د.أ</span>
        </div>

        <div class="item">
            <span>فتة مكدوس</span>
            <span class="price">5 د.أ</span>
        </div>

        <div class="item">
            <span>فتة حمص</span>
            <span class="price">5 د.أ</span>
        </div>

        <div class="item">
            <span>فتوش</span>
            <span class="price">4 د.أ</span>
        </div>

        <div class="section">إضافات</div>

        <div class="item">
            <span>كيلو رز</span>
            <span class="price">10 د.أ</span>
        </div>

        <div class="item">
            <span>جاج</span>
            <span class="price">5 د.أ</span>
        </div>

        <div class="item">
            <span>لحم بالحشوة</span>
            <span class="price">حسب الطلب</span>
        </div>

        <div class="note">
            جميع المنتجات متوفرة للاستفسار والطلب
            <br>
            📞 0790549925
        </div>

    </div>

    <div class="footer">
        DOLMA © 2026
    </div>

</div>

</body>
</html>
